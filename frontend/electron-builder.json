{
  "appId": "com.marketforge.desktop",
  "productName": "MarketForge",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": true
  }
}